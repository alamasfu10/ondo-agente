# Copia este fichero como .env y rellena tus valores. El .env no se sube nunca a git.

# Clave de OpenAI (la da EBIS). Empieza por sk-
OPENAI_API_KEY=

# Modelo de chat que usa el agente (opcional)
OPENAI_MODEL=gpt-4.1-mini

# Token del bot de Telegram: te lo da @BotFather en la clase del día 1
TELEGRAM_BOT_TOKEN=

# Voz de ElevenLabs en lugar de la de OpenAI (python -m canales.voz --voz elevenlabs).
# Obligatoria a partir del 6/01/2027, cuando OpenAI retira la voz que usa el kit por defecto.
# La clave sale de elevenlabs.io (API Keys) y el ID, de la voz elegida en su biblioteca (Voices)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
