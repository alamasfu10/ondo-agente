# Copia este fichero como .env y rellena tus valores. El .env no se sube nunca a git.

# Clave de OpenAI. Empieza por sk-
OPENAI_API_KEY=

# Modelo de chat que usa el agente
OPENAI_MODEL=gpt-4.1-mini

# Fecha de referencia de los datos simulados (AAAA-MM-DD). Vacía = hoy.
# Fíjala para que los tests y la evaluación den siempre lo mismo.
ONDO_HOY=

# Momento de referencia para el horario de atención en los tests (AAAA-MM-DDTHH:MM). Vacío = ahora.
ONDO_AHORA=

# Token del bot de Telegram (paso 10), de @BotFather
TELEGRAM_BOT_TOKEN=
