# Copia este fichero como .env y rellena tus valores. El .env no se sube nunca a git.

# Clave de OpenAI (la da EBIS). Empieza por sk-
OPENAI_API_KEY=

# Modelo de chat que usa el agente (opcional)
OPENAI_MODEL=gpt-4.1-mini

# Token del bot de Telegram: te lo da @BotFather en la clase del día 1
TELEGRAM_BOT_TOKEN=

# Solo para el teléfono (demo del docente, día 3). Para la voz en el navegador no hace falta.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Token de la página de la persona que recibe la llamada transferida (API key de Twilio)
TWILIO_API_KEY=
TWILIO_API_SECRET=
